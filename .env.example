# Dominio canônico da loja. Não use https:// nem caminhos.
SHOPIFY_SHOP_DOMAIN=example.myshopify.com
SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_API_VERSION=2026-07

# Escritas ficam desligadas por padrão. Mesmo ligadas, cada aplicação exige um confirmationToken emitido pela preparação correspondente.
SHOPIFY_ENABLE_WRITES=false
# Obrigatório quando SHOPIFY_ENABLE_WRITES=true.
SHOPIFY_AUDIT_LOG=C:\projetos\mcp-servers\shopify-mcp\data\audit.jsonl

# readonly: sem mutações; catalog: catálogo; orders: pedidos; full: tudo.
SHOPIFY_TOOL_PROFILE=readonly
SHOPIFY_CONFIRMATION_TTL_SECONDS=600
SHOPIFY_TIMEOUT_SECONDS=30
SHOPIFY_MAX_RETRIES=3
